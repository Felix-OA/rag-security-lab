# Choose a security profile. Baseline remains intentionally vulnerable.
RAG_SECURITY_PROFILE=baseline

# Choose exactly one provider mode. This key-free mode is the default.
MODEL_PROVIDER=extractive
MODEL_NAME=local-extractive-demo
MODEL_TEMPERATURE=0
MODEL_TIMEOUT_SECONDS=30

# OpenAI-compatible baseline example (uncomment and replace placeholders locally):
# MODEL_PROVIDER=openai_compatible
# OPENAI_BASE_URL=https://your-openai-compatible-host.example/v1
# OPENAI_API_KEY=replace-with-your-api-key-locally
# MODEL_NAME=replace-with-exact-model-name
# MODEL_TEMPERATURE=0
# MODEL_TIMEOUT_SECONDS=60
# OPENAI_API_KEY may be left empty only when a local endpoint does not require one.

RAG_TOP_K=4
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
EMBEDDING_DIMENSIONS=384
